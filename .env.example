# --- Fournisseur d'IA : "gemini" (gratuit, par défaut) ou "anthropic" ---
LLM_PROVIDER=gemini

# --- Gemini : clé gratuite sur https://aistudio.google.com/apikey ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Claude (uniquement si LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Accès et sécurité ---
# Si défini, l'API exige l'en-tête  Authorization: Bearer <API_TOKEN>
API_TOKEN=
# Hôtes autorisés pour l'outil HTTP (séparés par des virgules). Vide = tous les hôtes publics.
HTTP_ALLOWED_HOSTS=
# --- Email (SMTP) : sans ces valeurs, l'envoi est désactivé ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Mise en ligne publique ---
# true = désactive l'envoi d'emails (recommandé pour un service public)
PUBLIC_MODE=false
RATE_LIMIT_PER_MIN=15
DAILY_MESSAGE_CAP=500
# true uniquement derrière un proxy de confiance (Render, Caddy...) pour lire l'IP réelle
TRUST_PROXY=false
# Outils à désactiver, séparés par des virgules (ex : http_request,send_email)
DISABLED_TOOLS=
